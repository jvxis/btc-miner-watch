# Copie para .env.local e preencha. A pool lida e escolhida em /settings;
# basta a chave das pools que voce usa.

# ViaBTC
VIABTC_API_KEY=
VIABTC_SECRET_KEY=
VIABTC_BASE_URL=https://www.viabtc.net
VIABTC_COIN=BTC

# AntPool (https://www.antpool.com/userApi)
ANTPOOL_API_KEY=
ANTPOOL_API_SECRET=
# nome da conta/subconta, o mesmo prefixo dos workers (conta.maquina)
ANTPOOL_USER_ID=
# fuso das datas que a AntPool manda como texto; ajuste so se o ultimo share sair deslocado
# ANTPOOL_TIME_OFFSET=+00:00

POLL_INTERVAL_SECONDS=60
DB_PATH=data/miner-watch.db
